# vLLM Manager Configuration
# Copy this file to .env and modify as needed.
# NOTE: .env is parsed as simple KEY=VALUE pairs — it is NOT sourced as a
# shell script. Shell substitutions, command substitution, and `$(...)` in
# values are treated as literal text.

# --------- Container runtime ---------

# Container runtime: "podman" or "docker"
CONTAINER_RUNTIME=podman

# Run with sudo (required for rootful podman to access GPU devices)
# Set to empty string to disable: USE_SUDO=
USE_SUDO=sudo

# Container name
CONTAINER_NAME=vllm-manager

# Image name (after building)
IMAGE_NAME=vllm-manager:latest

# Run the container detached (true) or in foreground (false).
# systemd sets DETACH=false; interactive `bash run.sh` keeps the default.
DETACH=true

# --------- Storage ---------

# Models directory on the host
MODELS_DIR=/home/ollama/vllm_models

# --------- Ports / networking ---------

# Admin UI port on the host
ADMIN_PORT=7080

# Host interface the admin port is published on.
# Default 127.0.0.1 means the UI is only reachable from the host itself.
# Set to 0.0.0.0 for LAN access (combine with AUTH_ENABLED=true).
ADMIN_BIND_HOST=127.0.0.1

# vLLM API port range (one port per instance)
VLLM_PORT_START=8001
VLLM_PORT_END=8010

# --------- Authentication ---------

# Enable API key auth for the admin UI (recommended).
# Set to "false" ONLY on isolated on-prem networks where you explicitly
# don't want auth — the admin API can start/stop vLLM instances and
# delete models, so anyone who can reach it has full control.
AUTH_ENABLED=true

# Admin API key. If AUTH_ENABLED=true and this is empty, a random key is
# generated on startup and printed to the container logs.
ADMIN_API_KEY=

# --------- HuggingFace ---------

# HuggingFace token for gated/private model downloads (optional)
HF_TOKEN=

# --------- Resources ---------

# Shared memory size (needed for multi-GPU tensor parallelism)
SHM_SIZE=16g

# Temp filesystem sizes
TMP_SIZE=1g
CACHE_SIZE=2g

# GPU devices to pass through (space-separated)
# Use "auto" to detect all NVIDIA GPUs automatically
GPU_DEVICES=auto

# NVIDIA driver library paths (auto-detected if empty)
NVIDIA_ML_LIB=
CUDA_LIB=
NVPTX_LIB=

# --------- Security ---------

# Read-only container filesystem (true/false)
READ_ONLY=true

# SELinux: set to "true" to add :Z label on volume mounts (RHEL/CentOS/Fedora)
SELINUX_LABEL=false

# --------- Cluster / multi-node (remote GPUs over RDMA) ---------
# Span vLLM across GPUs on multiple boxes. When enabled, the container uses
# host networking + RDMA device passthrough so a Ray cluster can form across
# machines. Run the MANAGER on one box and a WORKER on each extra GPU box.
# All boxes must run the byte-identical image and have the model files at the
# same MODELS_DIR path. See README "Multi-node / remote GPUs".

# Enable cluster mode (host network, RDMA passthrough, Ray head/worker).
CLUSTER_MODE=false

# Role of this container: "manager" (admin UI + Ray head) or "worker" (Ray
# worker only; contributes its GPUs and blocks). One manager, N workers.
ADMIN_ROLE=manager

# Workers MUST set this to the manager box's IP (reachable over the mgmt net).
# Leave empty on the manager.
RAY_HEAD_HOST=

# Ray head port (GCS). Same value on manager and workers.
RAY_HEAD_PORT=6379

# This node's IP for Ray control traffic (usually the mgmt IP). Empty = Ray
# auto-detects. Set on multi-homed boxes to avoid Ray picking the wrong NIC.
RAY_NODE_IP=

# NCCL fabric tuning. All EMPTY by default = let NCCL auto-detect; set per fabric.
# NCCL_IB_HCA: pin to one HCA:port when a card exposes multiple ports on different
#   subnets (e.g. ConnectX-3), else NCCL cross-pairs them and the RDMA QP fails.
#   Example: mlx4_0:1
NCCL_IB_HCA=
# NCCL_IB_GID_INDEX: RoCEv2 GID index on some fabrics (find with `show_gids`).
#   Example: 3
NCCL_IB_GID_INDEX=
NCCL_IB_DISABLE=0
# NCCL_P2P_DISABLE: set 1 if GPU PCIe P2P is broken (no NVLink + host IOMMU in
# translated mode) — otherwise NCCL hangs at comm init. Forces the SHM transport.
NCCL_P2P_DISABLE=
# RoCE NIC for socket traffic. NICs are named differently per box, so set a
# COMMA LIST with THIS box's NIC FIRST. NCCL matches whichever exists on each
# node, and Ray copies the driver's value to all workers — so the list must be
# valid everywhere. Gloo (below) takes only the first entry.
#   manager .env: NCCL_SOCKET_IFNAME=enp196s0,ens2
#   ebola   .env: NCCL_SOCKET_IFNAME=ens2,enp196s0
NCCL_SOCKET_IFNAME=
# Gloo needs ONE interface that exists on THIS box (no comma list). Defaults to
# the first entry of NCCL_SOCKET_IFNAME; set explicitly only to override.
GLOO_SOCKET_IFNAME=

# RDMA char devices to pass through (space-separated). Empty = auto-detect
# /dev/infiniband/uverbs* and /dev/infiniband/rdma_cm.
RDMA_DEVICES=

# --------- Multi-GPU executor / all-reduce (hardware workarounds) ---------

# Executor for SINGLE-NODE multi-GPU (TP>1) instances: mp | ray. Default mp.
# vLLM's Ray executor hangs the TP forward on some hardware (V100 + no NVLink +
# host IOMMU); mp works there. Multi-node clusters always use ray regardless.
MULTIGPU_EXECUTOR=mp

# Add --disable-custom-all-reduce to every multi-GPU instance. Set "true" when GPU
# PCIe P2P is broken (custom all-reduce uses P2P and will hang). Default off, since
# custom all-reduce is faster on hardware with working P2P/NVLink.
DISABLE_CUSTOM_ALL_REDUCE=false

# --------- Compile cache ---------

# Where to persist torch.compile / Triton / vLLM kernel caches (a path INSIDE the
# container; /models is your MODELS_DIR). Default /models/.vllm-cache so restarts
# don't recompile from scratch. Set empty to disable persistence.
CACHE_DIR=/models/.vllm-cache

# --------- Misc ---------

# Extra arguments passed to the container runtime (podman/docker run).
# Parsed as a shell word list — not evaluated. Example:
#   EXTRA_ARGS=--dns 1.1.1.1
EXTRA_ARGS=

# --------- v0.4.0 control plane (opt-in; see docs/README.md) ---------
# The control plane replaces manual per-box startup with a per-node agent that dials the admin
# over a WebSocket (CCP), streams GPU telemetry, and executes commands. Default OFF keeps exact
# v0.3.0 behaviour. Roles are composable; most fabric settings are auto-detected per node and
# editable in the UI (docs/07-configuration.md).

# Enable the control plane (mounts /api/ccp + /cluster UI on the admin; agents on other nodes).
CONTROL_PLANE=false

# This node's roles, comma-separated: admin,participant,storage (any non-empty subset).
# Left empty, it is mapped from the legacy ADMIN_ROLE (manager->admin,participant,storage;
# worker->participant; single->all). Exactly one admin per cluster.
ROLES=

# Cluster identity an agent joins (one control plane per CLUSTER_ID).
CLUSTER_ID=default

# WORKER/participant nodes: the admin's control URL for the agent to dial.
# ws://<admin-host>:<ADMIN_PORT>  (wss:// if the admin serves TLS). If empty, it is derived
# from ADMIN_HOST/RAY_HEAD_HOST + ADMIN_PORT.
CCP_ADMIN_URL=
# Set 1 to skip TLS verification for a self-signed wss:// admin cert on a trusted fabric.
CCP_TLS_INSECURE=

# Stable node id (defaults to the hostname).
NODE_ID=
# The single model path every node sees (storage exports/mounts to this). Defaults to MODELS_DIR.
CANONICAL_MODEL_PATH=

# Control-plane timing (also editable in the UI). Agent heartbeat / telemetry intervals and the
# number of missed heartbeats before the admin marks a node DOWN.
CCP_HEARTBEAT_SEC=5
CCP_TELEMETRY_SEC=10
CCP_HEARTBEAT_MISS=3
