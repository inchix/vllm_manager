# vLLM Manager Configuration
# Copy this file to .env and modify as needed.
# NOTE: .env is parsed as simple KEY=VALUE pairs — it is NOT sourced as a
# shell script. Shell substitutions, command substitution, and `$(...)` in
# values are treated as literal text.

# --------- Container runtime ---------

# Container runtime: "podman" or "docker"
CONTAINER_RUNTIME=podman

# Run with sudo (required for rootful podman to access GPU devices)
# Set to empty string to disable: USE_SUDO=
USE_SUDO=sudo

# Container name
CONTAINER_NAME=vllm-manager

# Image name (after building)
IMAGE_NAME=vllm-manager:latest

# Run the container detached (true) or in foreground (false).
# systemd sets DETACH=false; interactive `bash run.sh` keeps the default.
DETACH=true

# --------- Storage ---------

# Models directory on the host
MODELS_DIR=/home/ollama/vllm_models

# --------- Ports / networking ---------

# Admin UI port on the host
ADMIN_PORT=7080

# Host interface the admin port is published on.
# Default 127.0.0.1 means the UI is only reachable from the host itself.
# Set to 0.0.0.0 for LAN access (combine with AUTH_ENABLED=true).
ADMIN_BIND_HOST=127.0.0.1

# vLLM API port range (one port per instance)
VLLM_PORT_START=8001
VLLM_PORT_END=8010

# --------- Authentication ---------

# Enable API key auth for the admin UI (recommended).
# Set to "false" ONLY on isolated on-prem networks where you explicitly
# don't want auth — the admin API can start/stop vLLM instances and
# delete models, so anyone who can reach it has full control.
AUTH_ENABLED=true

# Admin API key. If AUTH_ENABLED=true and this is empty, a random key is
# generated on startup and printed to the container logs.
ADMIN_API_KEY=

# --------- HuggingFace ---------

# HuggingFace token for gated/private model downloads (optional)
HF_TOKEN=

# --------- Resources ---------

# Shared memory size (needed for multi-GPU tensor parallelism)
SHM_SIZE=16g

# Temp filesystem sizes
TMP_SIZE=1g
CACHE_SIZE=2g

# GPU devices to pass through (space-separated)
# Use "auto" to detect all NVIDIA GPUs automatically
GPU_DEVICES=auto

# NVIDIA driver library paths (auto-detected if empty)
NVIDIA_ML_LIB=
CUDA_LIB=
NVPTX_LIB=

# --------- Security ---------

# Read-only container filesystem (true/false)
READ_ONLY=true

# SELinux: set to "true" to add :Z label on volume mounts (RHEL/CentOS/Fedora)
SELINUX_LABEL=false

# --------- Misc ---------

# Extra arguments passed to the container runtime (podman/docker run).
# Parsed as a shell word list — not evaluated. Example:
#   EXTRA_ARGS=--dns 1.1.1.1
EXTRA_ARGS=
